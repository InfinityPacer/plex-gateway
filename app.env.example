# Plex 内部地址，必填。必须指向 Gateway 可直连的 Plex origin，不能填写 Gateway 自己。
PLEX_URL=http://plex:32400

# Plex 管理 Token。仅用于启动校验和邻近媒体发现；留空仍会预热当前播放项。
# 不会写入日志、数据库或转发给 MediaVault/CDN。
PLEX_TOKEN=

# MediaVault 内部地址。启用 STRM 302 时必须与 PATH_MAPPINGS 同时配置。
MEDIAVAULT_URL=http://mediavault:7811

# Plex 媒体路径到 Gateway 容器内 STRM 路径的 JSON 映射。多个映射写在同一行。
PATH_MAPPINGS=[{"plex_prefix":"/media/cloud","local_prefix":"/strm"},{"plex_prefix":"/media/archive","local_prefix":"/archive-strm"}]

# Gateway 监听地址。容器内通常保持 :32400。
LISTEN_ADDR=:32400

# Gateway SQLite 数据库路径。容器部署应放在持久化的 /app_data 中。
DATABASE_PATH=/app_data/plex-gateway.db

# 日志级别，可选 debug、info、warn、error。
LOG_LEVEL=info

# 是否记录脱敏后的 Plex 请求顺序。默认开启，便于识别不同客户端的实际请求链路。
TRACE_ENABLED=true

# 识别为云端控制文件的扩展名，多个值以逗号分隔。
CLOUD_EXTENSIONS=.strm

# Part 内存缓存有效期。
PART_CACHE_TTL=24h

# MediaVault 直链解析的端到端超时。
RESOLVER_TIMEOUT=15s

# 观察 Plex metadata 响应时允许缓冲的最大字节数。
OBSERVE_MAX_BYTES=8388608

# 无响应体 Part 授权请求和 Plex 管理请求的超时。
PART_PROBE_TIMEOUT=15s

# 是否移除详细 metadata 请求中的 asyncAugmentMetadata。
# 默认开启，避免浏览请求调度 Plex 后台分析；checkFiles 仍透传以保留 accessible/exists。
METADATA_ANALYSIS_FILTER_ENABLED=true

# 是否限制单项详细 metadata 请求进入 Plex 的并发量。
METADATA_GUARD_ENABLED=true

# 所有客户端共享的单项详细 metadata 并发上限。当前默认值为 8。
# Plex MediaInfo 写库并完成重新压测后，才评估是否使用 16。
METADATA_GUARD_GLOBAL_CONCURRENCY=8

# 单个 Plex 客户端的单项详细 metadata 并发上限，当前默认值为 4。
METADATA_GUARD_CLIENT_CONCURRENCY=4

# 是否为逗号分隔的批量 metadata 请求启用独立并发保护。
METADATA_GUARD_BATCH_ENABLED=true

# 批量 metadata 请求的全局并发上限，当前默认值为 3。
METADATA_GUARD_BATCH_CONCURRENCY=3

# metadata 并发槽位的最长等待时间，超时返回 429。
METADATA_GUARD_QUEUE_TIMEOUT=10s

# 是否将认证、查询和客户端上下文完全一致的单项 metadata GET 合并为 Plex 原生批量读取。
METADATA_COALESCE_ENABLED=true

# 等待同组请求到达的微批窗口。允许范围不超过 100ms，默认值优先降低页面扇出。
METADATA_COALESCE_WINDOW=3ms

# 单个原生 Plex batch 最多包含的唯一 ratingKey，允许范围为 2-64。
METADATA_COALESCE_MAX_ITEMS=32

# 单个合成 batch 请求 Plex 并完成拆分的总超时。
METADATA_COALESCE_TIMEOUT=5s

# 是否启用 MediaInfo 缓存、远程探测和 Plex metadata 增强。
MEDIAINFO_ENABLED=true

# ffprobe 可执行文件路径。官方镜像中可直接使用 ffprobe。
MEDIAINFO_FFPROBE_PATH=ffprobe

# 单次 MediaInfo 远程探测的总超时。
MEDIAINFO_PROBE_TIMEOUT=20s

# ffprobe 的分析窗口参数，不是 HTTP 总下载量硬上限；应结合超时、并发和实际流量调优。
MEDIAINFO_PROBE_SIZE=8388608

# ffprobe 分析时长上限。
MEDIAINFO_ANALYZE_DURATION=5s

# ffprobe JSON 输出允许读取的最大字节数。
MEDIAINFO_OUTPUT_MAX_BYTES=2097152

# MediaInfo worker 并发数。CDN 风控敏感环境建议保持 1。
MEDIAINFO_CONCURRENCY=1

# P0 实际播放任务的独立内存队列上限，不与后台任务共享容量。
MEDIAINFO_PLAYBACK_QUEUE_SIZE=16

# P1 当前播放项前后邻近预热任务的内存队列上限。
MEDIAINFO_NEIGHBOR_QUEUE_SIZE=50

# 前台 metadata 冷 miss 的 P2 内存队列上限。
MEDIAINFO_METADATA_QUEUE_SIZE=50

# P1/P2 未开始任务的保留时间。过期任务不会访问 MediaVault 或 CDN。
MEDIAINFO_PENDING_TTL=5m

# P1/P2 在确认 L1 和 SQLite 都未命中后，实际启动远程探测的最小间隔。
MEDIAINFO_BACKGROUND_INTERVAL=5s

# 已知 MediaInfo 结果的新鲜期。过期后仍可返回旧值并在后台刷新。
MEDIAINFO_RECORD_TTL=720h

# 长期未访问记录的保留期，不能短于新鲜期。
MEDIAINFO_RECORD_RETENTION=4320h

# L1 内存缓存最多保存的 MediaInfo 记录数。
MEDIAINFO_L1_MAX_ENTRIES=10000

# 同一 Part、STRM fingerprint 和 User-Agent 探测失败后的抑制时间。
MEDIAINFO_NEGATIVE_TTL=15m

# 没有活动客户端上下文时，后台探测使用的 fallback User-Agent。
MEDIAINFO_USER_AGENT=Infuse-Library/8.5.1

# 实际播放 decision 冷缓存最多等待多久。metadata 浏览冷 miss 不等待，直接投递 P2 并返回。
MEDIAINFO_COLD_WAIT=5s

# 是否启用实验性 Apple TV Plex Dolby Vision Profile 5 播放 veto。默认关闭；
# 仅复用 decision 已取得的新鲜 MediaInfo，不发起额外探测，也不影响 Part 302。
PLAYBACK_VETO_ENABLED=false

# 单个 Plex metadata 响应允许缓冲并尝试增强的最大字节数。
MEDIAINFO_RESPONSE_MAX_BYTES=8388608

# 同时缓冲并尝试 L1 投影的单项 metadata 响应数量。
MEDIAINFO_ENRICHMENT_CONCURRENCY=8

# 当前播放项之前预热的邻近媒体数量。前后都设为 0 时仅提交当前项。
MEDIAINFO_PREWARM_BEFORE=2

# 当前播放项之后预热的邻近媒体数量。前后合计不能超过 50。
MEDIAINFO_PREWARM_AFTER=3

# HTTP 请求头读取超时。
READ_HEADER_TIMEOUT=15s

# HTTP keep-alive 空闲超时。
IDLE_TIMEOUT=90s

# 进程停止时等待 HTTP、预热和 MediaInfo worker 收尾的最长时间。
SHUTDOWN_TIMEOUT=15s
